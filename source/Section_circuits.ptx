      </cell>
    </row>
    <row>
      <cell>
        1
      </cell>
      <cell>
        0
      </cell>
      <cell right="medium">
        0
      </cell>
      <cell>
        1
      </cell>
    </row>
    <row>
      <cell>
        0
      </cell>
      <cell>
        1
      </cell>
      <cell right="medium">
        1
      </cell>
      <cell>
        1
      </cell>
    </row>
    <row>
      <cell>
        0
      </cell>
      <cell>
        1
      </cell>
      <cell right="medium">
        0
      </cell>
      <cell>
        0
      </cell>
    </row>
    <row>
      <cell>
        0
      </cell>
      <cell>
        0
      </cell>
      <cell right="medium">
        1
      </cell>
      <cell>
        0
      </cell>
    </row>
    <row>
      <cell>
        0
      </cell>
